<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="alarme.exe"
        Arguments=""
        InstallLocation="C:\Program Files\Alarme\Alarme">
    </Installer>
    <PackageInformation
        PackageName="Alarme"
        PackageDisplayName="Alarme"
        PublisherName="CN=xajiraqab"
        PublisherDisplayName="xajiraqab"
        Version="0.1.0.0"
        PackageDescription="Alarme">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.elmomento.reminders"
                Description="Alarme"
                DisplayName="Alarme"
                ExecutableName="alarme.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Alarme</DisplayName>
            <PublisherDisplayName>xajiraqab</PublisherDisplayName>
            <Description>Alarme</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="alarme.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
